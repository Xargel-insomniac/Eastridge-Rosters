rules_version = '2';

// Eastridge duty roster: who can read and change what.
// - Anyone can create an account and a doctor profile, but it starts unapproved.
// - Coordinators are listed in the `admins` collection (added by hand in the Firebase console).
// - Only approved doctors and coordinators can see rosters or change duties.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(uid())); }
    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/doctors/$(uid()))
        && get(/databases/$(database)/documents/doctors/$(uid())).data.approved == true;
    }
    function isMember() { return isAdmin() || isApproved(); }
    // A month ("2026-10") closes once it's over in Pakistan time (UTC+5); after that only coordinators change it.
    function monthNum(m) { return int(m.split('-')[0]) * 12 + int(m.split('-')[1]); }
    function nowMonthNum() {
      return (request.time + duration.value(5, 'h')).year() * 12 + (request.time + duration.value(5, 'h')).month();
    }
    function monthOpen(m) { return isAdmin() || monthNum(m) >= nowMonthNum(); }
    function validName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
    }

    // Announcement banner: everyone can read it, even before signing in; only coordinators change it.
    match /public/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && docId == 'announcement'
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.level in ['info', 'important', 'urgent']
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // Contact settings (MSA WhatsApp number): approved staff read, coordinators write.
    match /settings/{docId} {
      allow read: if isMember();
      allow write: if isAdmin() && docId == 'contact';
    }

    // Extended duties (over 12 hours): doctors ask, coordinators approve or not.
    match /extended/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.doctorId == uid());
      allow create, update: if isMember()
        && request.resource.data.doctorId is string
        && request.resource.data.key is string
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && (isAdmin() || (request.resource.data.status == 'pending' && request.resource.data.requestedBy == uid()));
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow list, write: if false;
    }

    match /doctors/{userId} {
      allow get: if isMember() || (signedIn() && uid() == userId);
      allow list: if isMember();
      // New profiles always start unapproved.
      allow create: if signedIn() && uid() == userId
        && request.resource.data.uid == userId
        && request.resource.data.approved == false
        && validName();
      // Doctors edit their own details but can't approve themselves; coordinators can change anything.
      allow update: if isAdmin()
        || (signedIn() && uid() == userId
            && request.resource.data.uid == userId
            && request.resource.data.approved == resource.data.approved
            && validName());
      allow delete: if isAdmin();
    }

    match /rosters/{rosterId} {
      allow read: if isMember();
      // Approved doctors can write rosters (an accepted swap updates both doctors' rosters).
      // Every change is also recorded in `requests`.
      allow create, update: if isMember()
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.doctorId is string
        && rosterId == request.resource.data.month + '_' + request.resource.data.doctorId
        && request.resource.data.shifts is map
        && request.resource.data.updatedBy == uid()
        && monthOpen(request.resource.data.month);
      allow delete: if isAdmin();
    }

    // Swap / hand-over requests and the change log. Coordinators see everything;
    // a doctor can only read requests they sent or received (the change log is for coordinators).
    match /requests/{reqId} {
      allow read: if isAdmin() || (isMember() && (resource.data.from == uid() || resource.data.to == uid()));
      allow create: if isMember()
        && request.resource.data.by == uid()
        && request.resource.data.type in ['swap', 'cover', 'move', 'edit']
        && request.resource.data.status in ['pending', 'done']
        && (request.resource.data.type in ['edit'] || request.resource.data.from == uid() || isAdmin())
        && request.resource.data.month is string && monthOpen(request.resource.data.month);
      // Only the colleague asked can accept or decline; only the sender can cancel.
      // Accepting a request from a closed month is blocked by the roster rule above.
      allow update: if isMember()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'reason'])
        && ((request.resource.data.status in ['accepted', 'declined', 'failed'] && (resource.data.to == uid() || isAdmin()))
            || (request.resource.data.status == 'cancelled' && (resource.data.from == uid() || isAdmin())));
      allow delete: if isAdmin();
    }
  }
}
