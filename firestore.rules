rules_version = '2';

// Eastridge duty roster: who can read and change what.
// - Anyone can create an account and a doctor profile, but it starts unapproved.
// - Coordinators are listed in the `admins` collection (added by hand in the Firebase console).
// - Only approved doctors and coordinators can see rosters or change duties.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(uid())); }
    function isApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/doctors/$(uid()))
        && get(/databases/$(database)/documents/doctors/$(uid())).data.approved == true;
    }
    function isMember() { return isAdmin() || isApproved(); }
    // A month ("2026-10") closes once it's over in Pakistan time (UTC+5); after that only coordinators change it.
    function monthNum(m) { return int(m.split('-')[0]) * 12 + int(m.split('-')[1]); }
    function nowMonthNum() {
      return (request.time + duration.value(5, 'h')).year() * 12 + (request.time + duration.value(5, 'h')).month();
    }
    function monthOpen(m) { return isAdmin() || monthNum(m) >= nowMonthNum(); }
    function validName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
    }

    // Announcement banner: everyone can read it, even before signing in; only coordinators change it.
    match /public/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && docId == 'announcement'
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.level in ['info', 'important', 'urgent']
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // Settings: contact details (MSA WhatsApp number, cover groups, consultants) are read by approved staff;
    // the expected staff list is for coordinators only. Only coordinators write.
    match /settings/{docId} {
      allow read: if isAdmin() || (isMember() && docId != 'staff');
      allow write: if isAdmin() && docId in ['contact', 'staff'];
    }

    // Station cover: a doctor on duty says whether they're covering an empty station. One answer per doctor per gap.
    match /cover/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.uid == uid()
        && request.resource.data.answer in ['yes', 'no']
        && request.resource.data.month is string
        && request.resource.data.date is string
        && request.resource.data.shift in ['M', 'E', 'N']
        && request.resource.data.dept is string
        && (resource == null || resource.data.uid == uid());
      allow delete: if isAdmin();
    }

    // Extended duties (over 12 hours): doctors ask, coordinators approve or not.
    match /extended/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.doctorId == uid());
      allow create, update: if isMember()
        && request.resource.data.doctorId is string
        && request.resource.data.key is string
        && request.resource.data.status in ['pending', 'approved', 'rejected']
        && (isAdmin() || (request.resource.data.status == 'pending' && request.resource.data.requestedBy == uid()));
      allow delete: if isAdmin();
    }

    // Incident reports (form EPC-RWP-QA-F-02): approved staff submit their own; they can read only theirs.
    // Coordinators read all and add the head's comments and status. Nobody else can change or delete a report.
    match /incidents/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.reportedBy == uid());
      allow create: if isMember()
        && request.resource.data.reportedBy == uid()
        && request.resource.data.status == 'new'
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0 && request.resource.data.details.size() <= 8000
        && !('headComments' in request.resource.data);
      allow update, delete: if isAdmin();

      // Evidence (photos and voice notes) saved with the report, readable by the same people as the report.
      // Added only by the reporter, together with the report, and small enough for the free database.
      match /files/{fileId} {
        allow read: if isAdmin() || (isMember() && get(/databases/$(database)/documents/incidents/$(id)).data.reportedBy == uid());
        allow create: if isMember()
          && request.resource.data.reportedBy == uid()
          && getAfter(/databases/$(database)/documents/incidents/$(id)).data.reportedBy == uid()
          && request.resource.data.kind in ['photo', 'audio']
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 900000;
        allow delete: if isAdmin();
      }
    }

    // Leave: doctors apply to their head of department (HOD). Reasons are confidential: only the doctor, the HOD
    // the request was sent to, and coordinators can read a request. The HOD decides; coordinators can decide any.
    function hodOf(g) { return get(/databases/$(database)/documents/settings/contact).data.get('hods', {}).get(g, ''); }
    match /leaves/{id} {
      allow read: if isAdmin() || (isMember() && (resource.data.uid == uid() || resource.data.hodUid == uid()));
      allow create: if isMember()
        && request.resource.data.uid == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.group in ['gynae', 'medicine', 'surgery', 'peds']
        && request.resource.data.type in ['casual', 'sick', 'emergency', 'expak']
        && request.resource.data.from is string && request.resource.data.to is string
        && request.resource.data.from <= request.resource.data.to
        && (request.resource.data.hodUid == '' || request.resource.data.hodUid == hodOf(request.resource.data.group))
        && request.resource.data.hodUid != uid()
        && !('decidedBy' in request.resource.data);
      allow update: if isAdmin()
        // the HOD it was sent to approves or declines it, once
        || (isMember() && resource.data.hodUid == uid() && resource.data.uid != uid() && resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'rejected'] && request.resource.data.decidedBy == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'comment', 'decidedBy', 'decidedAt', 'decidedRole', 'removed']))
        // the doctor cancels it, or records who they've asked to cover a duty, while it's waiting
        || (isMember() && resource.data.uid == uid() && resource.data.status == 'pending'
            && ((request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt']))
                || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['relief'])));
      allow delete: if isAdmin();
    }
    // Approved leave without the reason, so everyone's roster can show who is away.
    match /onleave/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        || (isMember() && getAfter(/databases/$(database)/documents/leaves/$(id)).data.hodUid == uid()
            && getAfter(/databases/$(database)/documents/leaves/$(id)).data.status == 'approved'
            && request.resource.data.uid == getAfter(/databases/$(database)/documents/leaves/$(id)).data.uid);
      allow delete: if isAdmin();
    }

    match /admins/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow list, write: if false;
    }

    match /doctors/{userId} {
      allow get: if isMember() || (signedIn() && uid() == userId);
      allow list: if isMember();
      // New profiles always start unapproved.
      allow create: if signedIn() && uid() == userId
        && request.resource.data.uid == userId
        && request.resource.data.approved == false
        && validName();
      // Doctors edit their own details but can't approve themselves; coordinators can change anything.
      // Once an approved doctor's profile is complete (profileLocked), their name and WhatsApp number only change
      // through the coordinator: they can ask (pendingChange) but not change them directly. Department and designation stay free.
      allow update: if isAdmin()
        || (signedIn() && uid() == userId
            && request.resource.data.uid == userId
            && request.resource.data.approved == resource.data.approved
            && validName()
            && (!(resource.data.get('profileLocked', false) == true && resource.data.approved == true)
                || resource.data.get('phone', '') == ''   // a missing number can always be added
                || (request.resource.data.name == resource.data.name
                    && request.resource.data.get('phone', '') == resource.data.get('phone', '')
                    && request.resource.data.get('profileLocked', false) == true))
            && (request.resource.data.get('email', '') == resource.data.get('email', '')
                || request.resource.data.get('email', '') == request.auth.token.get('email', '')));
      allow delete: if isAdmin();
    }

    match /rosters/{rosterId} {
      allow read: if isMember();
      // Approved doctors can write rosters (an accepted swap updates both doctors' rosters).
      // Every change is also recorded in `requests`.
      allow create, update: if isMember()
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.doctorId is string
        && rosterId == request.resource.data.month + '_' + request.resource.data.doctorId
        && request.resource.data.shifts is map
        && request.resource.data.updatedBy == uid()
        && monthOpen(request.resource.data.month);
      allow delete: if isAdmin();
    }

    // Swap / hand-over requests and the change log. Coordinators see everything;
    // a doctor can only read requests they sent or received (the change log is for coordinators).
    match /requests/{reqId} {
      allow read: if isAdmin() || (isMember() && (resource.data.from == uid() || resource.data.to == uid()));
      allow create: if isMember()
        && request.resource.data.by == uid()
        && request.resource.data.type in ['swap', 'cover', 'move', 'edit']
        && request.resource.data.status in ['pending', 'done']
        && (request.resource.data.type in ['edit'] || request.resource.data.from == uid() || isAdmin())
        && request.resource.data.month is string && monthOpen(request.resource.data.month);
      // Only the colleague asked can accept or decline; only the sender can cancel.
      // Accepting a request from a closed month is blocked by the roster rule above.
      allow update: if isMember()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'reason'])
        && ((request.resource.data.status in ['accepted', 'declined', 'failed'] && (resource.data.to == uid() || isAdmin()))
            || (request.resource.data.status == 'cancelled' && (resource.data.from == uid() || isAdmin())));
      allow delete: if isAdmin();
    }
  }
}
